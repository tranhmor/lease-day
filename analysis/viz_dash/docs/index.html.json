{"text": "<meta name=\"dash-one-writer\">\n<style>\n.ld { display: flex; flex-direction: column; gap: var(--cds-gap-xl); font-family: var(--font-anthropic-sans); color: var(--color-fg); font-size: var(--cds-font-size-body); line-height: 1.6; }\n.ld-title { font-family: var(--font-anthropic-serif); font-size: var(--cds-font-size-title); font-weight: 400; margin: 0; line-height: 1.25; }\n.ld-lede { max-width: 46rem; margin: var(--cds-gap-sm) 0 0; }\n.ld-small { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); margin: var(--cds-gap-xs) 0 0; max-width: 46rem; }\n.ld-h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0 0 var(--cds-gap-xs); }\n.ld-h3 { font-size: var(--cds-font-size-body); font-weight: var(--cds-font-weight-medium); margin: 0; }\n.ld-p { margin: 0 0 var(--cds-gap-md); max-width: 46rem; }\n.ld-n { font-weight: var(--cds-font-weight-medium); font-variant-numeric: tabular-nums; }\n.ld-section { display: flex; flex-direction: column; min-width: 0; }\n.ld-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); min-width: 0; display: flex; flex-direction: column; gap: var(--cds-gap-xs); }\n.ld-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: var(--cds-gap-md); }\n.ld-note { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); margin: 0; }\n\n.ld-arms { display: grid; grid-template-columns: minmax(4.5rem, auto) minmax(0, 1fr) minmax(0, 1fr); gap: var(--cds-gap-sm); align-items: stretch; }\n.ld-arm-head { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); align-self: end; }\n.ld-arm-side { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); align-self: center; }\n.ld-arm { border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-sm) var(--cds-pad-md); display: flex; flex-direction: column; gap: 2px; min-width: 0; }\n.ld-arm b { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); }\n.ld-formula { list-style: none; margin: var(--cds-gap-md) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--cds-gap-xs) var(--cds-gap-lg); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.ld-formula b { color: var(--color-fg); font-weight: var(--cds-font-weight-medium); }\n.ld-swatch { display: inline-block; width: 30px; height: 10px; vertical-align: middle; }\n.ld-swatch svg { display: block; }\n.ld-timeline { min-height: 62px; margin-top: var(--cds-gap-md); }\n\n.ld-controls { display: flex; flex-wrap: wrap; gap: var(--cds-gap-sm) var(--cds-gap-lg); align-items: center; margin-bottom: var(--cds-gap-md); }\n.ld-group { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cds-gap-xs); }\n.ld-group-name { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin-right: var(--cds-gap-xs); }\n.ld-btn { font: inherit; font-size: var(--cds-font-size-caption); color: var(--color-fg); background: transparent; border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-xs) var(--cds-pad-sm); cursor: pointer; min-height: 2rem; }\n.ld-btn:hover { background: var(--color-bg); }\n.ld-btn[aria-pressed=\"true\"] { background: var(--color-fg); color: var(--color-bg); border-color: var(--color-fg); }\n.ld-play { min-width: 4.5rem; font-weight: var(--cds-font-weight-medium); }\n.ld-range { flex: 1 1 12rem; min-width: 10rem; display: flex; align-items: center; gap: var(--cds-gap-sm); }\n.ld-range input { width: 100%; accent-color: var(--color-fg); }\n.ld-stage { display: flex; flex-wrap: wrap; gap: var(--cds-gap-lg); align-items: flex-start; }\n.ld-map { flex: 3 1 26rem; min-width: 0; }\n.ld-canvas-box { position: relative; width: 100%; }\n.ld-canvas-box canvas { display: block; width: 100%; touch-action: pan-y; }\n.ld-probe { position: absolute; visibility: hidden; pointer-events: none; }\n.ld-side { flex: 1 1 17rem; min-width: 0; display: flex; flex-direction: column; gap: var(--cds-gap-md); }\n.ld-month { font-family: var(--font-anthropic-serif); font-size: var(--cds-font-size-title); font-weight: 400; line-height: 1.2; }\n.ld-chips { display: flex; flex-wrap: wrap; gap: var(--cds-gap-xs); margin-top: var(--cds-gap-xs); }\n.ld-chip { font-size: var(--cds-font-size-caption); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: 0 var(--cds-pad-xs); color: var(--color-fg-muted); }\n.ld-stats { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px var(--cds-gap-md); font-size: var(--cds-font-size-caption); margin: 0; }\n.ld-stats dt { color: var(--color-fg-muted); margin: 0; }\n.ld-stats dd { margin: 0; text-align: right; font-variant-numeric: tabular-nums; }\n.ld-feed { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--cds-gap-xs); font-size: var(--cds-font-size-caption); line-height: 1.5; }\n.ld-feed li { border-top: 1px solid var(--color-border-line); padding-top: var(--cds-gap-xs); }\n.ld-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-xs) var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin-top: var(--cds-gap-sm); min-height: 1.5rem; align-items: center; }\n.ld-legend span { display: inline-flex; align-items: center; gap: var(--cds-gap-xs); }\n.ld-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; flex: none; }\n.ld-ramp { width: 72px; height: 9px; border-radius: 2px; display: inline-block; }\n\n.ld-key { display: flex; flex-wrap: wrap; gap: var(--cds-gap-xs) var(--cds-gap-lg); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin-bottom: var(--cds-gap-md); }\n.ld-key span.ld-key-item { display: inline-flex; align-items: center; gap: var(--cds-gap-xs); }\n.ld-chart { position: relative; width: 100%; min-height: 230px; }\n.ld-chart svg { display: block; overflow: visible; }\n.ld-tick { font-size: var(--cds-font-size-caption); fill: var(--color-fg-muted); font-variant-numeric: tabular-nums; }\n.ld-label { font-size: var(--cds-font-size-caption); fill: var(--color-fg); font-variant-numeric: tabular-nums; }\n.ld-label-strong { font-size: var(--cds-font-size-caption); fill: var(--color-fg); font-weight: var(--cds-font-weight-medium); font-variant-numeric: tabular-nums; }\n.ld-tip { position: absolute; left: 0; top: 0; pointer-events: none; opacity: 0; z-index: 2; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); line-height: 1.5; white-space: nowrap; }\n.ld-tip-head { color: var(--cds-text-secondary); }\n.ld-tip-line { display: flex; align-items: center; gap: var(--cds-gap-xs); font-variant-numeric: tabular-nums; }\n\n.ld-table-wrap { overflow-x: auto; }\n.ld-eff { display: grid; grid-template-columns: minmax(10rem, 1.4fr) repeat(3, minmax(6rem, 1fr)); column-gap: var(--cds-gap-md); font-size: var(--cds-font-size-caption); min-width: 34rem; }\n.ld-eff-head { color: var(--color-fg-muted); padding-bottom: var(--cds-gap-xs); border-bottom: 1px solid var(--color-border-line); }\n.ld-eff-body { display: grid; grid-column: 1 / -1; grid-template-columns: subgrid; }\n.ld-eff-row { display: grid; grid-column: 1 / -1; grid-template-columns: subgrid; padding: var(--cds-gap-xs) 0; border-bottom: 1px solid var(--color-border-line); align-items: center; }\n.ld-eff-num { font-variant-numeric: tabular-nums; display: flex; gap: var(--cds-gap-xs); align-items: baseline; }\n.ld-eff-num b { font-weight: var(--cds-font-weight-medium); }\n.ld-pm { color: var(--color-fg-muted); }\n.ld-whisk { display: block; width: 100%; height: 16px; }\n.ld-table { border-collapse: collapse; width: 100%; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n.ld-table th { text-align: right; font-weight: 400; color: var(--color-fg-muted); padding: var(--cds-gap-xs) var(--cds-gap-sm); border-bottom: 1px solid var(--color-border-line); }\n.ld-table td { text-align: right; padding: var(--cds-gap-xs) var(--cds-gap-sm); border-bottom: 1px solid var(--color-border-line); }\n.ld-table th:first-child, .ld-table td:first-child { text-align: left; padding-left: 0; }\n.ld-table tr.ld-hl td { font-weight: var(--cds-font-weight-medium); }\n[data-dash-source-state=refreshing] { opacity: .5; }\n@media (prefers-reduced-motion: no-preference) { .ld-tip { transition: opacity 80ms linear; } }\n</style>\n\n<div class=\"ld\">\n  <header id=\"top\">\n    <h1 class=\"ld-title\">《到期日》实验可视化</h1>\n    <p class=\"ld-lede\">新线开通后，受益区租客通勤少 <span class=\"ld-n\" data-draw=\"v\" data-f=\"1\" data-source=\"effects\" data-field=\"size\" data-where=\"metric=watch_commute&amp;effect=direct\">—</span> 分钟，但他们只占全部租客的 <span class=\"ld-n\" data-draw=\"v\" data-f=\"1\" data-source=\"levels\" data-field=\"value\" data-where=\"key=share_in\">—</span>%。这些区域本来就住满了，几乎没人能迁入；统计窗口内，受益区租金只比没有新线时多涨 <span class=\"ld-n\" data-draw=\"v\" data-f=\"2\" data-source=\"effects\" data-field=\"size\" data-where=\"metric=watch_rent&amp;effect=interaction\">—</span> 个指数点。</p>\n    <p class=\"ld-small\">规则版，没有 LLM，四组各 <span data-draw=\"v\" data-source=\"levels\" data-field=\"value\" data-where=\"key=seeds\">—</span> 局，同一编号的随机种子配对。这些数字用来检查设计，不代表北京的真实情况。</p>\n  </header>\n\n  <section class=\"ld-section\" id=\"design\">\n    <h2 class=\"ld-h2\">实验设计：两个因素，四组</h2>\n    <p class=\"ld-p\">所有租客都在 CBD 上班，<span class=\"ld-n\" data-draw=\"v\" data-source=\"levels\" data-field=\"value\" data-where=\"key=rooms\">—</span> 间房分布在 <span class=\"ld-n\" data-draw=\"v\" data-source=\"levels\" data-field=\"value\" data-where=\"key=zones\">—</span> 个住房区域。每回合一个月，共 <span class=\"ld-n\" data-draw=\"v\" data-source=\"levels\" data-field=\"value\" data-where=\"key=months\">—</span> 个月。第 <span class=\"ld-n\" data-draw=\"v\" data-source=\"levels\" data-field=\"value\" data-where=\"key=opens\">—</span> 个月，假想的东向快线开通，果园和武夷花园的地铁通勤变短；冻结组的租金从这个月起不再变化。结果取最后 <span class=\"ld-n\" data-draw=\"v\" data-source=\"levels\" data-field=\"value\" data-where=\"key=tail\">—</span> 个月的平均。</p>\n    <div class=\"ld-card\">\n      <div class=\"ld-arms\">\n        <div></div>\n        <div class=\"ld-arm-head\">租金正常变化</div>\n        <div class=\"ld-arm-head\">租金冻结</div>\n        <div class=\"ld-arm-side\">没有新线</div>\n        <div class=\"ld-arm\"><b>A</b><span class=\"ld-note\">基线</span><span class=\"ld-swatch\" data-draw=\"arm-swatch\" data-arm=\"A\"></span></div>\n        <div class=\"ld-arm\"><b>A0</b><span class=\"ld-note\">对照，用来扣除冻结本身</span><span class=\"ld-swatch\" data-draw=\"arm-swatch\" data-arm=\"A0\"></span></div>\n        <div class=\"ld-arm-side\">有新线</div>\n        <div class=\"ld-arm\"><b>C</b><span class=\"ld-note\">新线，租金变化</span><span class=\"ld-swatch\" data-draw=\"arm-swatch\" data-arm=\"C\"></span></div>\n        <div class=\"ld-arm\"><b>B</b><span class=\"ld-note\">新线，租金不变</span><span class=\"ld-swatch\" data-draw=\"arm-swatch\" data-arm=\"B\"></span></div>\n      </div>\n      <ul class=\"ld-formula\">\n        <li><b>直接效应 = B − A0</b>：租金不动时，新线带来多少</li>\n        <li><b>总效应 = C − A</b>：租金能动时，新线带来多少</li>\n        <li><b>交互影响 = 总效应 − 直接效应</b>：租金反应把结果改变了多少</li>\n      </ul>\n      <div class=\"ld-timeline\" data-draw=\"timeline\" data-source=\"levels\"></div>\n    </div>\n  </section>\n\n  <section class=\"ld-section\" id=\"replay\">\n    <h2 class=\"ld-h2\">回放一局：每个点是一间房</h2>\n    <p class=\"ld-p\">实心点是有人住的房间，空心点是空房。这是编号 <span class=\"ld-n\" data-draw=\"v\" data-source=\"levels\" data-field=\"value\" data-where=\"key=replay_seed\">—</span> 的一局，不是平均值；四组用同一个种子，所以开通前完全相同，之后才分开。按“播放”看租客怎样搬家，切换分组时月份不变。</p>\n    <div class=\"ld-card\">\n      <div class=\"ld-controls\">\n        <div class=\"ld-group\" role=\"group\" aria-label=\"选择实验组\">\n          <span class=\"ld-group-name\">实验组</span>\n          <button type=\"button\" class=\"ld-btn\" data-ld-arm=\"A\" aria-pressed=\"false\">A 没有新线</button>\n          <button type=\"button\" class=\"ld-btn\" data-ld-arm=\"A0\" aria-pressed=\"false\">A0 冻结</button>\n          <button type=\"button\" class=\"ld-btn\" data-ld-arm=\"B\" aria-pressed=\"false\">B 新线，冻结</button>\n          <button type=\"button\" class=\"ld-btn\" data-ld-arm=\"C\" aria-pressed=\"true\">C 新线，变化</button>\n        </div>\n        <div class=\"ld-group\" role=\"group\" aria-label=\"点的颜色表示什么\">\n          <span class=\"ld-group-name\">颜色</span>\n          <button type=\"button\" class=\"ld-btn\" data-ld-mode=\"commute\" aria-pressed=\"true\">通勤时间</button>\n          <button type=\"button\" class=\"ld-btn\" data-ld-mode=\"rent\" aria-pressed=\"false\">房租变化</button>\n          <button type=\"button\" class=\"ld-btn\" data-ld-mode=\"income\" aria-pressed=\"false\">收入组</button>\n          <button type=\"button\" class=\"ld-btn\" data-ld-mode=\"way\" aria-pressed=\"false\">上班方式</button>\n        </div>\n        <div class=\"ld-range\">\n          <button type=\"button\" class=\"ld-btn ld-play\"><span class=\"ld-when-paused\">播放</span><span class=\"ld-when-playing\" hidden>暂停</span></button>\n          <input class=\"ld-month-input\" id=\"ld-month\" type=\"range\" min=\"0\" max=\"60\" step=\"1\" value=\"25\" aria-label=\"月份\">\n        </div>\n      </div>\n      <div class=\"ld-stage\">\n        <div class=\"ld-map\">\n          <div data-draw=\"replay-map\" data-source=\"replay replay_rooms replay_people zones metro map levels\"></div>\n          <div class=\"ld-legend\" data-draw=\"replay-legend\"></div>\n        </div>\n        <div class=\"ld-side\">\n          <div>\n            <div class=\"ld-month\">第 <span data-draw=\"replay-stat\" data-stat=\"month\">—</span> 个月</div>\n            <div class=\"ld-chips\">\n              <span class=\"ld-chip ld-show-before\">新线未开通</span>\n              <span class=\"ld-chip ld-show-open\" hidden>新线已开通</span>\n              <span class=\"ld-chip ld-show-none\" hidden>本组没有新线</span>\n              <span class=\"ld-chip ld-show-frozen\" hidden>租金已冻结</span>\n            </div>\n          </div>\n          <dl class=\"ld-stats\">\n            <dt>受益区平均通勤（分钟）</dt><dd data-draw=\"replay-stat\" data-stat=\"commute_in\">—</dd>\n            <dt>其他区域平均通勤（分钟）</dt><dd data-draw=\"replay-stat\" data-stat=\"commute_out\">—</dd>\n            <dt>受益区房租，起始价 = 100</dt><dd data-draw=\"replay-stat\" data-stat=\"rent_in\">—</dd>\n            <dt>其他区域房租，起始价 = 100</dt><dd data-draw=\"replay-stat\" data-stat=\"rent_out\">—</dd>\n            <dt>受益区空房</dt><dd data-draw=\"replay-stat\" data-stat=\"vacant_in\">—</dd>\n            <dt>其他区域空房</dt><dd data-draw=\"replay-stat\" data-stat=\"vacant_out\">—</dd>\n            <dt>本月到期</dt><dd data-draw=\"replay-stat\" data-stat=\"renewals\">—</dd>\n            <dt>本月搬家</dt><dd data-draw=\"replay-stat\" data-stat=\"moves\">—</dd>\n            <dt>本月离开（付不起）</dt><dd data-draw=\"replay-stat\" data-stat=\"left\">—</dd>\n            <dt>本月新来者进不来</dt><dd data-draw=\"replay-stat\" data-stat=\"blocked\">—</dd>\n          </dl>\n          <div>\n            <h3 class=\"ld-h3\">这个月发生了什么</h3>\n            <ul class=\"ld-feed\" data-draw=\"replay-feed\"></ul>\n          </div>\n        </div>\n      </div>\n      <p class=\"ld-note\">地铁线是 2018 年路网（OpenStreetMap）。区域按真实方向摆放，为了放下所有点，靠近中心的区域向外移开，最多约 <span data-draw=\"v\" data-f=\"1\" data-source=\"levels\" data-field=\"value\" data-where=\"key=max_shift_km\">—</span> 公里。东向快线只是示意，没有真实走向。</p>\n    </div>\n  </section>\n\n  <section class=\"ld-section\" id=\"paths\">\n    <h2 class=\"ld-h2\">逐月结果：通勤马上变，租金慢慢变</h2>\n    <p class=\"ld-p\">四组各 <span class=\"ld-n\" data-draw=\"v\" data-source=\"levels\" data-field=\"value\" data-where=\"key=seeds\">—</span> 局的平均，浅色带是 A、C 两组的 95% 区间。竖线是开通，右侧阴影是统计窗口。</p>\n    <div class=\"ld-key\">\n      <span class=\"ld-key-item\"><span class=\"ld-swatch\" data-draw=\"arm-swatch\" data-arm=\"A\"></span>A 没有新线，租金变化</span>\n      <span class=\"ld-key-item\"><span class=\"ld-swatch\" data-draw=\"arm-swatch\" data-arm=\"A0\"></span>A0 没有新线，租金冻结</span>\n      <span class=\"ld-key-item\"><span class=\"ld-swatch\" data-draw=\"arm-swatch\" data-arm=\"C\"></span>C 新线，租金变化</span>\n      <span class=\"ld-key-item\"><span class=\"ld-swatch\" data-draw=\"arm-swatch\" data-arm=\"B\"></span>B 新线，租金冻结</span>\n    </div>\n    <div class=\"ld-grid\">\n      <div class=\"ld-card\" id=\"path-commute\">\n        <h3 class=\"ld-h3\">通勤在开通当月就下降</h3>\n        <p class=\"ld-note\">受益区租客平均通勤（分钟）。开通当月少 <span data-draw=\"v\" data-f=\"1\" data-source=\"levels\" data-field=\"value\" data-where=\"key=commute_jump\">—</span> 分钟，之后没有继续下降。</p>\n        <div class=\"ld-chart\" data-draw=\"path\" data-metric=\"watch_commute\" data-digits=\"1\" data-source=\"monthly\"></div>\n      </div>\n      <div class=\"ld-card\" id=\"path-rent\">\n        <h3 class=\"ld-h3\">租金差慢慢拉开</h3>\n        <p class=\"ld-note\">受益区租金指数（起点 = 100）。开通前就在涨，到统计窗口已涨 <span data-draw=\"v\" data-f=\"1\" data-source=\"levels\" data-field=\"value\" data-where=\"key=drift_rent_A\">—</span> 点（A 组），这部分和新线无关。</p>\n        <div class=\"ld-chart\" data-draw=\"path\" data-metric=\"watch_rent\" data-digits=\"1\" data-source=\"monthly\"></div>\n      </div>\n      <div class=\"ld-card\" id=\"path-gap\">\n        <h3 class=\"ld-h3\">到最后一个月，租金差还在扩大</h3>\n        <p class=\"ld-note\">C − A 的受益区租金指数差和 95% 区间。第 48 个月 <span data-draw=\"v\" data-f=\"2\" data-source=\"levels\" data-field=\"value\" data-where=\"key=rent_gap_48\">—</span>，第 60 个月 <span data-draw=\"v\" data-f=\"2\" data-source=\"levels\" data-field=\"value\" data-where=\"key=rent_gap_60\">—</span>。统计窗口的平均值没有反映这个趋势。</p>\n        <div class=\"ld-chart\" data-draw=\"gap\" data-metric=\"watch_rent\" data-effect=\"total\" data-digits=\"2\" data-source=\"effect_by_month\"></div>\n      </div>\n      <div class=\"ld-card\" id=\"path-inquiry\">\n        <h3 class=\"ld-h3\">房东看到的询盘只多了一点</h3>\n        <p class=\"ld-note\">受益区每间房每月询盘。开通后 12 个月，有新线比没有新线只多 <span data-draw=\"v\" data-f=\"1\" data-source=\"levels\" data-field=\"value\" data-where=\"key=inq_gain\">—</span>%。冻结组不统计询盘，所以只画两组。</p>\n        <div class=\"ld-chart\" data-draw=\"path\" data-metric=\"inq_in\" data-arms=\"A,C\" data-digits=\"2\" data-source=\"monthly\"></div>\n      </div>\n      <div class=\"ld-card\" id=\"path-subway\">\n        <h3 class=\"ld-h3\">有人改坐地铁，但基线本身在漂移</h3>\n        <p class=\"ld-note\">受益区租客坐地铁的占比（%，含骑车接地铁）。A 组没有新线，也从 <span data-draw=\"v\" data-source=\"levels\" data-field=\"value\" data-where=\"key=subway_start\">—</span>% 降到 <span data-draw=\"v\" data-source=\"levels\" data-field=\"value\" data-where=\"key=subway_end\">—</span>%。</p>\n        <div class=\"ld-chart\" data-draw=\"path\" data-metric=\"mode_in_subway\" data-digits=\"1\" data-source=\"monthly\"></div>\n      </div>\n      <div class=\"ld-card\" id=\"path-movein\">\n        <h3 class=\"ld-h3\">搬入受益区的人没有变多，反而略少</h3>\n        <p class=\"ld-note\">开通后从其他区域累计搬入受益区的人数。有新线时反而略少，可能是因为住在里面的人更少搬走，空出的房更少。</p>\n        <div class=\"ld-chart\" data-draw=\"path\" data-metric=\"cum_in\" data-digits=\"1\" data-source=\"monthly\"></div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"ld-section\" id=\"effects\">\n    <h2 class=\"ld-h2\">效应分解</h2>\n    <p class=\"ld-p\">点是平均值，线段是 95% 区间，竖线是零。每行有自己的刻度，只看区间是否离开零。深色表示区间不含零。</p>\n    <div class=\"ld-card ld-table-wrap\">\n      <div class=\"ld-eff\">\n        <div class=\"ld-eff-head\">指标</div>\n        <div class=\"ld-eff-head\">直接效应 B − A0</div>\n        <div class=\"ld-eff-head\">总效应 C − A</div>\n        <div class=\"ld-eff-head\">交互影响</div>\n        <div class=\"ld-eff-body\" data-draw=\"effects\" data-source=\"effects\"></div>\n      </div>\n      <p class=\"ld-note\" style=\"margin-top: var(--cds-gap-sm)\">“累计”是开通后到第 60 个月的总数，其余是统计窗口的平均。</p>\n    </div>\n  </section>\n\n  <section class=\"ld-section\" id=\"ledger\">\n    <h2 class=\"ld-h2\">好处和代价分给了谁</h2>\n    <p class=\"ld-p\">受益区里，低收入者省的时间最多。房东每间房的月收入小幅增加，其他区域的人和房东几乎不受影响。这是统计窗口内各组住户的平均，住户在换，不是跟踪同一批人。</p>\n    <div class=\"ld-card ld-table-wrap\" data-source=\"ledger\">\n      <table class=\"ld-table\">\n        <thead><tr><th>谁</th><th>人数（C 组）</th><th>通勤（B − A0，分钟）</th><th>月租或房东收入（C − A，元）</th><th>通勤费（B − A0，元）</th></tr></thead>\n        <tbody data-draw=\"ledger\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"ld-section\" id=\"zones\">\n    <h2 class=\"ld-h2\">分区结果：只有两个受益区明显变化</h2>\n    <p class=\"ld-p\">周边区域没有明显的外溢。空置率很低也不是受益区独有的：<span class=\"ld-n\" data-draw=\"v\" data-source=\"levels\" data-field=\"value\" data-where=\"key=vac_low_zones\">—</span> 个区域低于 5%，高空置集中在 <span class=\"ld-n\" data-draw=\"v\" data-source=\"levels\" data-field=\"value\" data-where=\"key=vac_high_zones\">—</span> 个区域，最高 <span class=\"ld-n\" data-draw=\"v\" data-f=\"1\" data-source=\"levels\" data-field=\"value\" data-where=\"key=vac_max\">—</span>%；扣掉这些区域，其他区域约 <span class=\"ld-n\" data-draw=\"v\" data-f=\"1\" data-source=\"levels\" data-field=\"value\" data-where=\"key=vac_rest\">—</span>%。所以受益区 <span class=\"ld-n\" data-draw=\"v\" data-f=\"1\" data-source=\"levels\" data-field=\"value\" data-where=\"key=vac_in\">—</span>% 与其他区域 <span class=\"ld-n\" data-draw=\"v\" data-f=\"1\" data-source=\"levels\" data-field=\"value\" data-where=\"key=vac_out\">—</span>% 的对比，主要反映少数区域空置很高。</p>\n    <div class=\"ld-card ld-table-wrap\">\n      <div class=\"ld-chart\" style=\"min-height: 560px; min-width: 34rem\" data-draw=\"zones\" data-source=\"zones\"></div>\n      <p class=\"ld-note\">按地铁门到门时间从近到远排列。空置率来自 A 组统计窗口；租金差是 C − A，通勤差是 B − A0。</p>\n    </div>\n  </section>\n\n  <section class=\"ld-section\" id=\"checks\">\n    <h2 class=\"ld-h2\">和真实数据、其他假设对照</h2>\n    <div class=\"ld-grid\">\n      <div class=\"ld-card\">\n        <h3 class=\"ld-h3\">新线的租金差：真实挂牌与规则版</h3>\n        <p class=\"ld-note\">线段是 95% 区间。真实线路的点估计有正有负，多数区间包含零；规则版的估计落在 14、16 号线的区间内。两边窗口和口径不同，只比量级，真实值也只是描述性比较。</p>\n        <div class=\"ld-chart\" style=\"min-height: 300px\" data-draw=\"forest\" data-source=\"real_vs_rule\"></div>\n      </div>\n      <div class=\"ld-card\">\n        <h3 class=\"ld-h3\">改假设后，受益区租金差变化不大</h3>\n        <p class=\"ld-note\">C − A，早先的假设检验，局数较少。竖线是零。</p>\n        <div class=\"ld-chart\" style=\"min-height: 340px\" data-draw=\"assume\" data-source=\"assumptions\"></div>\n      </div>\n      <div class=\"ld-card\">\n        <h3 class=\"ld-h3\">低价房减少的影响比新线大得多</h3>\n        <p class=\"ld-note\">来自同一组假设检验。低价房和便宜单间一起减少。</p>\n        <div class=\"ld-table-wrap\">\n          <table class=\"ld-table\" data-source=\"assumptions\" data-row-key=\"variant\">\n            <thead><tr><th data-field=\"label\">低价房</th><th data-field=\"seated\">入住户数</th><th data-field=\"low_over30\">低收入超 30%（%）</th><th data-field=\"left\">离开（人）</th><th data-field=\"blocked_low\">被挡（次）</th></tr></thead>\n            <tbody data-draw=\"lowcost\"></tbody>\n          </table>\n        </div>\n      </div>\n      <div class=\"ld-card\">\n        <h3 class=\"ld-h3\">房东的定价规则改变租金差</h3>\n        <p class=\"ld-note\">交互影响（指数点）。询盘强度是假设，没有按真实溢价调参。</p>\n        <div class=\"ld-table-wrap\">\n          <table class=\"ld-table\" data-source=\"landlord_rules\" data-row-key=\"k\">\n            <thead><tr><th data-field=\"label\">房东规则</th><th data-field=\"express\">假想快线</th><th data-field=\"express_h\">±</th><th data-field=\"replay\">真实路网回放</th><th data-field=\"replay_h\">±</th></tr></thead>\n            <tbody data-draw=\"rules\"></tbody>\n          </table>\n        </div>\n      </div>\n      <div class=\"ld-card\">\n        <h3 class=\"ld-h3\">基线和现实比较</h3>\n        <p class=\"ld-note\">A 组，统计窗口。局数比早先的基线多，数字略有差别。上班方式已用北京调查校准，这里的比较不算完全独立。</p>\n        <div class=\"ld-table-wrap\">\n          <table class=\"ld-table\" data-source=\"baseline\" data-row-key=\"metric\">\n            <thead><tr><th data-field=\"metric\">指标</th><th data-field=\"model\">模型</th><th data-field=\"real\">现实</th></tr></thead>\n            <tbody data-draw=\"baseline\"></tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n    <p class=\"ld-small\">重算：在 prototype 文件夹运行 viz_v06.py，再在 analysis 文件夹运行 viz_build.py。记录脚本不改规则，也不抽随机数，总数和 scenarios_v06.py 的输出一致。</p>\n  </section>\n</div>\n<script src=\"charts.js\"></script>\n<script src=\"replay.js\"></script>\n"}